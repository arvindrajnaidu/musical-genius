{
  "name": "musical-genius",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:native": "NEXT_BUILD_TARGET=native NEXT_PUBLIC_NATIVE_BUILD=1 next build",
    "start": "next start",
    "lint": "eslint",
    "cap:sync": "npm run build:native && cap sync",
    "cap:assets": "capacitor-assets generate --iconBackgroundColor '#1e1b4b' --iconBackgroundColorDark '#1e1b4b' --splashBackgroundColor '#1e1b4b' --splashBackgroundColorDark '#1e1b4b' --logoSplashScale 0.4 && rm -rf icons public/manifest.webmanifest",
    "ios": "npm run build:native && cap sync ios && cap open ios",
    "android": "npm run build:native && cap sync android && cap open android",
    "rules:deploy": "npx -y firebase-tools deploy --only database",
    "test": "vitest run",
    "rules:check": "node scripts/rules-check.mjs",
    "ios:testflight": "npm run build:native && cap sync ios && bash scripts/testflight.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "firebase": "^12.19.0",
    "next": "^16.2.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
