# Firebase web config for the musical-genius project.
# Console → Project settings → General → Your apps → Web app → SDK config.
# Copy to .env.local for local dev, and add the same keys in Vercel.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=musical-genius.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=musical-genius
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=musical-genius.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# YouTube Data API v3 key (used for song search from phones). Restrict it to the
# YouTube Data API and your domains in Google Cloud Console.
NEXT_PUBLIC_YOUTUBE_API_KEY=
